Vector3f PlantModel::getAccel() {
    return accel;
}
Vector3f PlantModel::getGyro() {
    return gyro;
}

void PlantModel::setMotor(uint8_t ch, uint16_t pwm) {
    if (ch < 4) {
        motor_outputs[ch] = (pwm-1000) / 950.0f; // PWM to normalized value
    }
}