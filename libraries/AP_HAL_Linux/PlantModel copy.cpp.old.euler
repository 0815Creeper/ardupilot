#include "PlantModel.h"

#include <stdio.h>


void PlantModel::init() {
    position.zero();
    velocity.zero();
    angles.zero();
    omega.zero();
    accel.zero();
    gyro.zero();

    inertia = Matrix3f();
    inertia.a.x = PLANT_INERTIA_ROLL; // Roll inertia
    inertia.b.y = PLANT_INERTIA_PITCH; // Pitch inertia
    inertia.c.z = PLANT_INERTIA_YAW; // Yaw inertia

    for (int i = 0; i < 4; i++) {
        motor_outputs[i] = 0.0f;
    }
}

void PlantModel::update(float dt) {
    // Transformation
    Matrix3f R = rotation_matrix();

    // Kräfte
    Vector3f F_thrust = R.transposed() * thrust_body();
    Vector3f F_g = Vector3f(0, 0, GRAVITY_MSS * mass);
    Vector3f F_total;
    if(abs(F_thrust.z) > abs(F_g.z)) {
        on_gnd = false;
    }else if(motor_outputs[0] == 0 && motor_outputs[1] == 0 && motor_outputs[2] == 0 && motor_outputs[3] == 0) {
        on_gnd = true;
    }
    F_total = F_thrust + F_g;
    if (on_gnd) {
        F_total.x = 0;
        F_total.y = 0;
        F_total.z = 0;
        velocity.x = 0;
        velocity.y = 0;
        velocity.z = 0;
        angles.x = 0;
        angles.y = 0;
        angles.z = 0;
        position.x = 0;
        position.y = 0;
        position.z = 0;
        omega.x = 0;
        omega.y = 0;
        omega.z = 0;
    }
    Vector3f acc = F_total / mass;

    // Translation
    velocity += acc * dt;
    position += velocity * dt;

    // Drehmomente
    Vector3f torque = torque_body();
    
    Vector3f I_diag = Vector3f(inertia.a.x, inertia.b.y, inertia.c.z); // Diagonale extrahieren
    Vector3f omega_cross_Iomega = omega % Vector3f(
        I_diag.x * omega.x,
        I_diag.y * omega.y,
        I_diag.z * omega.z
    );

    Vector3f omega_dot;
    omega_dot.z = (torque.z - omega_cross_Iomega.z) / I_diag.z;
    omega_dot.x = (torque.x - omega_cross_Iomega.x) / I_diag.x;
    omega_dot.y = (torque.y - omega_cross_Iomega.y) / I_diag.y;

    // Rotation
    omega += omega_dot * dt;
    if (on_gnd) {
        omega.x = 0;
        omega.y = 0;
        omega.z = 0;
    }
    angles += omega * dt; // Annahme: kleine Winkel
    
    // Sensorwerte
    accel = (R.transposed() * (Vector3f(0, 0, -GRAVITY_MSS) + acc)); // IMU frame
    gyro = omega;
    
    static int count = 0;
    count++;
    if(!on_gnd&&count % 100 == 0) {
        printf("ong: %i\n", on_gnd);
        printf("wld: %f, %f, %f\n", F_thrust.x, F_thrust.y, F_thrust.z);
        printf("acc: %f, %f, %f\n", thrust_body().x, thrust_body().y, thrust_body().z);
        printf("angles: %f, %f, %f\n", degrees(angles.x), degrees(angles.y), degrees(angles.z));
        printf("position: %f, %f, %f\n", position.x, position.y, position.z);
    }
    
}

Vector3f PlantModel::thrust_body() {
    // Vereinfachter thrust entlang Z für jeden Motor (nach unten)
    float total_thrust = 0.0f;
    for (int i = 0; i < 4; i++) {
        total_thrust += constrain_float(motor_outputs[i], 0.0f, 1.0f);
    }
    return Vector3f(0, 0, -(total_thrust) * PLANT_THRUST_FACT); // 8 N maximal (vereinfachte Skala)
}

Vector3f PlantModel::torque_body() {
    float L = arm_length;
    float m[4];
    for (int i = 0; i < 4; i++) {
        m[i] = constrain_float(motor_outputs[i], 0.0f, 1.0f);
    }

    float tau_x = L / sqrtf(2) *PLANT_THRUST_FACT* -1.0*(m[0] + m[3] - m[1] -m[2]);  // Roll
    float tau_y = L / sqrtf(2) *PLANT_THRUST_FACT* (m[0] + m[2] - m[1] -m[3]);  // Pitch
    float tau_z = PLANT_YAW_TORQUE_FACT *PLANT_THRUST_FACT* (m[0] + m[1] - m[2] - m[3]); // Yaw, Drehmoment durch Gegendrehung

    return Vector3f(tau_x, tau_y, tau_z);
}

Matrix3f PlantModel::rotation_matrix() {
    float cx = cosf(angles.x), sx = sinf(angles.x);
    float cy = cosf(angles.y), sy = sinf(angles.y);
    float cz = cosf(angles.z), sz = sinf(angles.z);

    Matrix3f R;
    R.a.x = cy * cz;
    R.a.y = cy * sz;
    R.a.z = -sy;

    R.b.x = sx * sy * cz - cx * sz;
    R.b.y = sx * sy * sz + cx * cz;
    R.b.z = sx * cy;

    R.c.x = cx * sy * cz + sx * sz;
    R.c.y = cx * sy * sz - sx * cz;
    R.c.z = cx * cy;

    return R;
}

